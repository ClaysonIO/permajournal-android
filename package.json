{
  "name": "permajournal-android",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/search-assets.mjs && vite",
    "build": "node scripts/search-assets.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
